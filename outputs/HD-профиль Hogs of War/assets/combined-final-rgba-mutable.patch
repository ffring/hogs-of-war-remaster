+    static void capture_final_rgba_array(ID3D11DeviceContext *context, ID3D11ShaderResourceView *srv)
+    {
+        const char *enabled = std::getenv("TT_DGVOODOO_FINAL_RGBA");
+        const bool env_enabled = enabled != nullptr && enabled[0] == '1' && enabled[1] == '\0';
+        if ((!env_enabled && !ConfigManager::get().get_config().final_rgba_readback) || context == nullptr || srv == nullptr ||
+            D3D11Hook::s_inside_injection || context->GetType() != D3D11_DEVICE_CONTEXT_IMMEDIATE)
+            return;
+
+        D3D11_SHADER_RESOURCE_VIEW_DESC view = {};
+        srv->GetDesc(&view);
+        if (view.Format != DXGI_FORMAT_R8G8B8A8_UNORM || view.ViewDimension != D3D11_SRV_DIMENSION_TEXTURE2DARRAY ||
+            view.Texture2DArray.FirstArraySlice != 0 || view.Texture2DArray.ArraySize != 1 ||
+            view.Texture2DArray.MostDetailedMip != 0 || view.Texture2DArray.MipLevels != 1)
+            return;
+
+        ID3D11Resource *resource = nullptr;
+        srv->GetResource(&resource);
+        if (resource == nullptr)
+            return;
+
+        ID3D11Texture2D *texture = nullptr;
+        if (FAILED(resource->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void **>(&texture))) || texture == nullptr)
+        {
+            resource->Release();
+            return;
+        }
+
+        D3D11_TEXTURE2D_DESC source_desc = {};
+        texture->GetDesc(&source_desc);
+        if (source_desc.Width < 16 || source_desc.Height < 16 || source_desc.Width > 512 || source_desc.Height > 512 ||
+            source_desc.MipLevels != 1 || source_desc.ArraySize != 1 || source_desc.SampleDesc.Count != 1 ||
+            source_desc.Usage != D3D11_USAGE_DEFAULT || source_desc.CPUAccessFlags != 0 ||
+            (source_desc.BindFlags & D3D11_BIND_SHADER_RESOURCE) == 0 ||
+            (source_desc.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS && source_desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM))
+        {
+            texture->Release();
+            resource->Release();
+            return;
+        }
+
+        const size_t resource_bytes = static_cast<size_t>(source_desc.Width) * source_desc.Height * 4u;
+        bool reserved = false;
+        {
+            std::lock_guard<std::mutex> lock(s_final_rgba_capture_mutex);
+            FinalRgbaCaptureState state = {};
+            UINT marker_size = sizeof(state);
+            if (FAILED(resource->GetPrivateData(s_final_rgba_capture_marker, &marker_size, &state)) || marker_size != sizeof(state))
+                state = {};
+            if (state.complete || state.dirty || state.in_progress || state.attempts >= 2 ||
+                s_final_rgba_capture_count >= 128 || s_final_rgba_capture_bytes + resource_bytes > 32u * 1024u * 1024u)
+            {
+                texture->Release();
+                resource->Release();
+                return;
+            }
+            ++state.attempts;
+            state.in_progress = 1;
+            if (FAILED(resource->SetPrivateData(s_final_rgba_capture_marker, sizeof(state), &state)))
+            {
+                texture->Release();
+                resource->Release();
+                return;
+            }
+            s_final_rgba_capture_bytes += resource_bytes;
+            reserved = true;
+        }
+
+        auto finish_attempt = [&](bool success)
+        {
+            if (!reserved)
+                return;
+            std::lock_guard<std::mutex> lock(s_final_rgba_capture_mutex);
+            FinalRgbaCaptureState state = {};
+            UINT marker_size = sizeof(state);
+            if (FAILED(resource->GetPrivateData(s_final_rgba_capture_marker, &marker_size, &state)) || marker_size != sizeof(state))
+                state = {};
+            state.in_progress = 0;
+            state.complete = success ? 1 : 0;
+            resource->SetPrivateData(s_final_rgba_capture_marker, sizeof(state), &state);
+            if (success)
+                ++s_final_rgba_capture_count;
+            else if (s_final_rgba_capture_bytes >= resource_bytes)
+                s_final_rgba_capture_bytes -= resource_bytes;
+            reserved = false;
+        };
+
+        ID3D11Device *device = nullptr;
+        texture->GetDevice(&device);
+        if (device == nullptr)
+        {
+            finish_attempt(false);
+            texture->Release();
+            resource->Release();
+            return;
+        }
+
+        D3D11_TEXTURE2D_DESC staging_desc = source_desc;
+        staging_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM; // compatible concrete view format for typeless backing
+        staging_desc.Usage = D3D11_USAGE_STAGING;
+        staging_desc.BindFlags = 0;
+        staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        staging_desc.MiscFlags = 0;
+        ID3D11Texture2D *staging = nullptr;
+        HRESULT hr = device->CreateTexture2D(&staging_desc, nullptr, &staging);
+        if (FAILED(hr) || staging == nullptr)
+        {
+            Logger::get().warn("[FinalRGBAReadback] staging creation failed for " + ptr_hex(resource) + " HRESULT=" + std::to_string(hr));
+            finish_attempt(false);
+            device->Release();
+            texture->Release();
+            resource->Release();
+            return;
+        }
+
+        bool registered = false;
+        D3D11_MAPPED_SUBRESOURCE mapped = {};
+        {
+            ScopedFlag no_reentry(D3D11Hook::s_inside_injection);
+            context->CopyResource(staging, texture);
+            hr = context->Map(staging, 0, D3D11_MAP_READ, 0, &mapped);
+            if (SUCCEEDED(hr))
+            {
+                if (mapped.pData != nullptr && mapped.RowPitch >= source_desc.Width * 4u)
+                {
+                    const UINT tight_row = source_desc.Width * 4u;
+                    const uint64_t hash = compute_hash64_rows(static_cast<const uint8_t *>(mapped.pData), mapped.RowPitch,
+                                                              tight_row, source_desc.Height);
+                    Logger::get().info("[FinalRGBAReadback] resource=" + ptr_hex(resource) + " srv=" + ptr_hex(srv) +
+                        " dimensions=" + std::to_string(source_desc.Width) + "x" + std::to_string(source_desc.Height) +
+                        " source_format=" + std::to_string(static_cast<UINT>(source_desc.Format)) +
+                        " row_pitch=" + std::to_string(mapped.RowPitch) + " hash=0x" + format_hash_hex(hash));
+                    registered = hash != 0 && TextureManager::get().register_unmap_texture11(device, resource, mapped.pData,
+                        source_desc.Width, source_desc.Height, DXGI_FORMAT_R8G8B8A8_UNORM, mapped.RowPitch, nullptr, 0, true);
+                }
+                else
+                {
+                    Logger::get().warn("[FinalRGBAReadback] invalid mapped data/pitch for " + ptr_hex(resource) +
+                        " row_pitch=" + std::to_string(mapped.RowPitch));
+                }
+                // A successful Map must always be paired with Unmap, even if pData or pitch is invalid.
+                context->Unmap(staging, 0);
+            }
+        }
+
+        if (FAILED(hr))
+            Logger::get().warn("[FinalRGBAReadback] staging Map failed for " + ptr_hex(resource) + " HRESULT=" + std::to_string(hr));
+        finish_attempt(registered);
+
+        staging->Release();
+        device->Release();
+        texture->Release();
+        resource->Release();
+    }
