+        const HRESULT hr = context->SetPrivateDataInterface(s_final_rgba_context_state_guid, state);
+        dirty_guard_diag("context.SetPrivateDataInterface.exit", context);
+        if (FAILED(hr))
+        {
+            state->Release();
+            return nullptr;
+        }
+        return state;
+    }
