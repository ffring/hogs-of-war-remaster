+                ID3D11ShaderResourceView *view = item.view;
+                original_set(context, item.slot, 1, &view);
+                view->Release();
+            }
+        }
+
+        void dirty_targets()
+        {
+            std::array<ID3D11Resource *, D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT> targets = {};
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                for (size_t i = 0; i < targets.size(); ++i)
+                {
+                    targets[i] = m_targets[i];
+                    if (targets[i] != nullptr) targets[i]->AddRef();
+                }
