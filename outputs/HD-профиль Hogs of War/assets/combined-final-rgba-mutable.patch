+    // Attached to each immediate context as private COM data, so its COM references are
+    // released with the context rather than kept in a process-global pointer map.
+    class FinalRgbaContextState final : public IUnknown
+    {
+    public:
+        HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void **out) override
+        {
+            if (out == nullptr) return E_POINTER;
+            *out = nullptr;
+            if (IsEqualIID(iid, IID_IUnknown))
+            {
+                *out = static_cast<IUnknown *>(this);
+                AddRef();
+                return S_OK;
+            }
+            return E_NOINTERFACE;
+        }
+        ULONG STDMETHODCALLTYPE AddRef() override { return ++m_refs; }
+        ULONG STDMETHODCALLTYPE Release() override
+        {
+            const ULONG refs = --m_refs;
+            if (refs == 0) delete this;
+            return refs;
+        }
+
+        ~FinalRgbaContextState() { clear(); }
+
+        void clear()
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (ID3D11Resource *&resource : m_targets)
+            {
+                if (resource != nullptr) resource->Release();
+                resource = nullptr;
+            }
+            for (TrackedPsOverride &slot : m_ps_overrides)
+                clear_slot(slot);
+        }
+
+        void set_targets(ID3D11Resource *const *resources, size_t count)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (ID3D11Resource *&resource : m_targets)
+            {
+                if (resource != nullptr) resource->Release();
+                resource = nullptr;
+            }
+            count = (std::min)(count, m_targets.size());
+            for (size_t i = 0; i < count; ++i)
+            {
+                m_targets[i] = resources[i];
+                if (m_targets[i] != nullptr) m_targets[i]->AddRef();
+            }
+        }
+
+        void forget_target(ID3D11Resource *resource)
+        {
+            if (resource == nullptr) return;
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (ID3D11Resource *&target : m_targets)
+            {
+                if (target == resource)
+                {
+                    target->Release();
+                    target = nullptr;
+                }
+            }
+        }
+
+        void remember_ps(UINT start, UINT count, ID3D11ShaderResourceView *const *originals,
+                         ID3D11ShaderResourceView *const *actuals)
+        {
+            struct NewSlot { ID3D11ShaderResourceView *view; ID3D11Resource *resource; };
+            std::array<NewSlot, D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT> replacements = {};
+            if (start >= D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT) return;
+            const UINT end = start + (std::min)(count, static_cast<UINT>(D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT) - start);
+            for (UINT slot = start; slot < end; ++slot)
+            {
+                ID3D11ShaderResourceView *original = originals != nullptr ? originals[slot - start] : nullptr;
+                ID3D11ShaderResourceView *actual = actuals != nullptr ? actuals[slot - start] : nullptr;
+                if (original != nullptr && actual != original)
+                {
+                    ID3D11Resource *resource = nullptr;
+                    original->GetResource(&resource);
+                    if (resource != nullptr)
+                    {
+                        original->AddRef();
+                        replacements[slot].view = original;
+                        replacements[slot].resource = resource; // GetResource returns an owned ref
+                    }
+                }
+            }
+            std::lock_guard<std::mutex> lock(m_mutex);
+            for (UINT slot = start; slot < end; ++slot)
+            {
+                clear_slot(m_ps_overrides[slot]);
+                m_ps_overrides[slot].original = replacements[slot].view;
+                m_ps_overrides[slot].resource = replacements[slot].resource;
+                replacements[slot] = {};
+            }
+            for (NewSlot &slot : replacements)
+            {
+                if (slot.view != nullptr) slot.view->Release();
+                if (slot.resource != nullptr) slot.resource->Release();
+            }
+        }
+
+        void restore_ps_for_resources(ID3D11DeviceContext *context, PsSetShaderResourcesFn original_set,
+                                      ID3D11Resource *const *resources, size_t count)
+        {
+            if (context == nullptr || original_set == nullptr || resources == nullptr || count == 0)
+                return;
+            struct Restore { UINT slot; ID3D11ShaderResourceView *view; };
+            std::vector<Restore> restore;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                for (UINT slot = 0; slot < m_ps_overrides.size(); ++slot)
+                {
+                    TrackedPsOverride &binding = m_ps_overrides[slot];
+                    bool match = false;
+                    for (size_t i = 0; i < count; ++i)
+                        if (binding.resource != nullptr && binding.resource == resources[i]) { match = true; break; }
+                    if (match)
