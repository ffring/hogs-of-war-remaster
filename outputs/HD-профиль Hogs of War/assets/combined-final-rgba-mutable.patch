+    static FinalRgbaContextState *get_final_rgba_context_state(ID3D11DeviceContext *context, bool create)
+    {
+        if (context == nullptr)
+            return nullptr;
+        dirty_guard_diag("context.GetPrivateData.enter", context);
+        IUnknown *unknown = nullptr;
+        UINT size = sizeof(unknown);
+        const HRESULT get_hr = context->GetPrivateData(s_final_rgba_context_state_guid, &size, &unknown);
+        dirty_guard_diag("context.GetPrivateData.exit", context);
