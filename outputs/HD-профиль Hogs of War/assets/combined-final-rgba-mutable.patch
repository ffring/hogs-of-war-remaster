+                    resource->Release();
+                }
+            }
+        }
+
+    private:
+        static void clear_slot(TrackedPsOverride &slot)
+        {
+            if (slot.original != nullptr) slot.original->Release();
+            if (slot.resource != nullptr) slot.resource->Release();
+            slot = {};
+        }
+
+        std::atomic<ULONG> m_refs{1};
+        std::mutex m_mutex;
+        std::array<ID3D11Resource *, D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT> m_targets = {};
+        std::array<TrackedPsOverride, D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT> m_ps_overrides = {};
+    };
